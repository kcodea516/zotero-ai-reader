{
  "name": "zotero-ai-reader",
  "version": "1.4.0-beta.2",
  "private": true,
  "description": "Zotero AI reader with local paper context, cross-paper retrieval, and OpenAI-compatible APIs",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build:smoke": "node scripts/build-smoke.mjs",
    "build:showcase": "esbuild scripts/showcase.ts --bundle --format=iife --global-name=AIReaderShowcase --platform=browser --target=firefox140 --outfile=build/showcase.js"
  },
  "dependencies": {
    "dompurify": "3.4.17",
    "katex": "0.19.0",
    "markdown-it": "14.3.3"
  },
  "devDependencies": {
    "@types/katex": "0.16.7",
    "@types/markdown-it": "14.1.2",
    "@types/node": "24.10.1",
    "esbuild": "0.25.12",
    "typescript": "5.9.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kcodea516/zotero-ai-reader.git"
  },
  "homepage": "https://github.com/kcodea516/zotero-ai-reader",
  "bugs": {
    "url": "https://github.com/kcodea516/zotero-ai-reader/issues"
  }
}
